<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>__LABEL__</string>
    <key>BundleProgram</key><string>Contents/MacOS/LidPowerHelper</string>
    <key>ProgramArguments</key><array><string>Contents/MacOS/LidPowerHelper</string><string>__APP_ID__</string></array>
    <key>MachServices</key><dict><key>__LABEL__</key><true/></dict>
    <!-- Runs at boot to restore the flag if a previous run could not;
         relaunched after a crash; exits on its own when idle. -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <!-- Launch constraint, enforced by macOS 14+: launchd starts the job only
         if the executable is this Developer ID-signed helper of team
         8XZ7Z4UR6C. A replaced binary in the user-writable app bundle is
         refused instead of running as root. -->
    <key>SpawnConstraint</key>
    <dict>
        <key>team-identifier</key><string>8XZ7Z4UR6C</string>
        <key>signing-identifier</key><string>__LABEL__</string>
        <key>validation-category</key><integer>6</integer>
    </dict>
    <key>AssociatedBundleIdentifiers</key><array><string>__APP_ID__</string></array>
</dict>
</plist>
